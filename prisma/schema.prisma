datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Admin {
  id           String       @id @default(uuid())
  email        String       @unique
  passwordHash String
  name         String
  role         String       @default("COACH") // SUPER_ADMIN or COACH
  pointEntries PointEntry[]
  auditLogs    AuditLog[]
}

model Student {
  id            String            @id @default(uuid())
  rollNumber    String            @unique
  name          String
  className     String
  house         String?
  photoUrl      String?
  gender        String?           // "MALE" | "FEMALE" | "OTHER" — nullable, additive
  schoolId      String?
  departmentId  String?
  sportId       String?           // primary sport
  pointEntries  PointEntry[]
  eventParticipants EventParticipant[]
  cheers        Cheer[]
  awards        Award[]

  school        School?           @relation(fields: [schoolId], references: [id])
  department    Department?       @relation(fields: [departmentId], references: [id])
  sport         Sport?            @relation(fields: [sportId], references: [id])

  @@index([className])
  @@index([schoolId])
  @@index([gender])
}

model School {
  id          String       @id @default(uuid())
  name        String
  code        String       @unique
  logoUrl     String?
  color       String?      // brand color for visualization
  students    Student[]
  departments Department[]
  awards      Award[]

  @@index([name])
}

model Department {
  id        String    @id @default(uuid())
  name      String
  code      String
  schoolId  String
  students  Student[]

  school    School    @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, code])
  @@index([schoolId])
}

model House {
  id          String   @id @default(uuid())
  name        String   @unique
  color       String?  // e.g. "RED", "BLUE", "GREEN", "YELLOW"
  points      Int      @default(0)

  @@index([name])
}

model Sport {
  id          String   @id @default(uuid())
  name        String   @unique
  icon        String?
  gender      String?  // "MEN" | "WOMEN" | "MIXED"
  unit        String?  // e.g. "seconds", "points", "meters"
  events      Event[]
  students    Student[]

  @@index([name])
}

model Event {
  id              String            @id @default(uuid())
  name            String
  date            DateTime
  sportId         String?
  category        String?           // e.g. "Men's Singles", "Women's Doubles"
  venue           String?
  startTime       DateTime?
  endTime         DateTime?
  status          String            @default("SCHEDULED") // DRAFT | SCHEDULED | LIVE | PAUSED | ENDED | ARCHIVED
  broadcastUrl    String?
  thumbnail       String?
  commentary      String?
  pointEntries    PointEntry[]
  eventParticipants EventParticipant[]
  broadcasts      Broadcast[]

  sport           Sport?            @relation(fields: [sportId], references: [id])

  @@unique([name, date])
  @@index([sportId])
  @@index([status])
  @@index([date])
}

model EventParticipant {
  id              String   @id @default(uuid())
  studentId       String
  eventId         String
  status          String   @default("REGISTERED") // REGISTERED | PARTICIPATED | DISQUALIFIED | WITHDRAWN | ABSENT | WINNER
  placement       Int?     // 1st, 2nd, 3rd, etc.
  points          Float    @default(0)
  participationDate DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([studentId, eventId])
  @@index([studentId])
  @@index([eventId])
  @@index([status])
}

model PointEntry {
  id          String   @id @default(uuid())
  studentId   String
  eventId     String
  points      Float
  position    Int?
  enteredById String

  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  enteredBy   Admin    @relation(fields: [enteredById], references: [id])

  @@unique([studentId, eventId])
  @@index([studentId])
  @@index([eventId])
}

model Broadcast {
  id              String            @id @default(uuid())
  eventId         String?
  title           String
  description     String?
  streamUrl       String?           // HLS / embed URL from streaming provider
  thumbnail       String?
  status          String            @default("DRAFT") // DRAFT | SCHEDULED | LIVE | PAUSED | ENDED | ARCHIVED
  startedAt       DateTime?
  endedAt         DateTime?
  viewerCount     Int               @default(0)
  chatEnabled     Boolean           @default(true)
  cheerEnabled    Boolean           @default(true)
  instagramGateEnabled Boolean        @default(true)

  event           Event?            @relation(fields: [eventId], references: [id])
  broadcastSessions BroadcastSession[]
  cheers          Cheer[]
  viewerSessions  ViewerSession[]

  @@index([status])
  @@index([eventId])
}

model BroadcastSession {
  id          String   @id @default(uuid())
  broadcastId String
  sessionId   String   // anonymous session ID
  joinedAt    DateTime @default(now())
  leftAt      DateTime?

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@index([broadcastId])
  @@index([sessionId])
}

model Cheer {
  id          String   @id @default(uuid())
  broadcastId String
  sessionId   String?
  studentId   String?
  type        String   // "CLAP" | "FIRE" | "GO" | "CHAMPIONS" | "SUPPORT"
  createdAt   DateTime @default(now())

  broadcast   Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  student     Student?  @relation(fields: [studentId], references: [id])

  @@index([broadcastId])
  @@index([createdAt])
}

model ViewerSession {
  id              String   @id @default(uuid())
  broadcastId     String
  sessionId       String   // anonymous session ID
  joinedAt        DateTime @default(now())
  leftAt          DateTime?
  instagramFollowed Boolean  @default(false)

  broadcast       Broadcast @relation(fields: [broadcastId], references: [id], onDelete: Cascade)

  @@unique([broadcastId, sessionId])
  @@index([broadcastId])
  @@index([sessionId])
}

model Award {
  id              String   @id @default(uuid())
  name            String
  description     String?
  year            Int
  awardCategoryId String?
  studentId       String?
  schoolId        String?
  points          Float?

  awardCategory   AwardCategory? @relation(fields: [awardCategoryId], references: [id])
  student         Student?       @relation(fields: [studentId], references: [id])
  school          School?        @relation(fields: [schoolId], references: [id])

  @@index([year])
  @@index([awardCategoryId])
  @@index([studentId])
}

model AwardCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  gender      String?  // "MEN" | "WOMEN" | "MIXED" | null (open)
  awards      Award[]

  @@index([name])
}

model AuditLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String   // "CREATE" | "UPDATE" | "DELETE" | "RESULT_OVERRIDE" | "POINT_RULE_CHANGE"
  entityType  String   // "Student" | "Event" | "PointEntry" | "Broadcast" | etc.
  entityId    String?
  details     Json?
  createdAt   DateTime @default(now())

  admin       Admin    @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entityType])
  @@index([createdAt])
}
